  "fixed_sql": [
    {
      "name": "local_user_session",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_user_session\" (\"slot\" INTEGER NOT NULL DEFAULT 0, \"user_id\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"roles\" TEXT NOT NULL, \"permissions\" TEXT NOT NULL DEFAULT '[]', \"factory_ids\" TEXT NOT NULL DEFAULT '[]', \"location_ids\" TEXT NOT NULL DEFAULT '[]', \"profile_loaded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"profile_loaded\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {
      "name": "local_device_context",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_device_context\" (\"slot\" INTEGER NOT NULL DEFAULT 0, \"device_id\" TEXT NOT NULL, \"device_code\" TEXT NOT NULL, \"device_name\" TEXT NOT NULL, \"factory_id\" TEXT NOT NULL, \"factory_code\" TEXT NOT NULL, \"factory_name\" TEXT NOT NULL, \"factory_timezone\" TEXT NOT NULL, \"trolley_id\" TEXT NOT NULL, \"trolley_code\" TEXT NOT NULL, \"trolley_name\" TEXT NOT NULL, \"trolley_location_id\" TEXT NOT NULL, \"server_time\" INTEGER NOT NULL, \"sync_cursor\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {
      "name": "local_device_validation",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_device_validation\" (\"slot\" INTEGER NOT NULL DEFAULT 0, \"device_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"checked_at\" INTEGER NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {
      "name": "local_needle_type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_needle_type\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NULL, \"unit\" TEXT NOT NULL, \"minimum_stock\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_exchange_type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_exchange_type\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"requires_fragment_validation\" INTEGER NOT NULL CHECK (\"requires_fragment_validation\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_storage_mapping",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_storage_mapping\" (\"id\" TEXT NOT NULL, \"exchange_type_id\" TEXT NOT NULL, \"storage_location_id\" TEXT NOT NULL, \"storage_location_code\" TEXT NOT NULL, \"storage_location_name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
