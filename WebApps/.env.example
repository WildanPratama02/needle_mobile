# Copy to .env.local and adjust.

# Backend origin that /api/v1/* is forwarded to (next.config.mjs rewrites).
# The browser always calls the API on this WebApp's own origin and Next.js
# proxies it, so there is no CORS preflight and login works from any host you
# open the app on (localhost, 127.0.0.1, a LAN IP) regardless of the Backend's
# CORS_ORIGINS. Server-only — never exposed to the browser.
#
# Origin only, no /api/v1 suffix. Backend runs on PORT=3000 by default
# (Backend/.env.example); this WebApp runs on 3200 (package.json "dev").
# For `next build`, set it at build time: the rewrite is baked into the build.
API_PROXY_TARGET=http://localhost:3000
