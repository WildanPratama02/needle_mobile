# Copy to .env.local and adjust.

# Backend's versioned REST API (Backend/CLAUDE.md §3, Backend/src/bootstrap.ts).
# Backend runs on PORT=3000 by default (Backend/.env.example) — this dev
# server runs on 3100 (see package.json "dev" script) precisely so the two
# don't collide on the same port during local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
