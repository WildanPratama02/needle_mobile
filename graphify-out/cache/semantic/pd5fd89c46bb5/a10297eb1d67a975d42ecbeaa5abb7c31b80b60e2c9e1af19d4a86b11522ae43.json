{"nodes": [{"id": "backend_architecture_doc", "label": "Backend ARCHITECTURE.md", "file_type": "document", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scratch_exchange_final_review_doc", "label": "Exchange Final Review", "file_type": "document", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_19_backend_folder_structure_doc", "label": "Backend Folder Structure Spec", "file_type": "document", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_architecture_exchange_state_machine", "label": "Exchange State Machine (Pure Function)", "file_type": "rationale", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exchange-state-machine.ts imports neither Prisma nor Nest; takes a context and action and returns the states-path to write or throws, so all 41 tests run without a database. Returns a path, not a single state, and owns requiresStockReversal()/NON_TERMINAL_STATES so adding a state cannot silently miss them. 'Blocked' is not a persisted state, only a description of a stuck condition."}, {"id": "backend_architecture_stock_ledger_invariants", "label": "Stock Ledger Invariants (Three Layers)", "file_type": "rationale", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conditional compare-and-set decrement prevents concurrent over-issue; database CHECK constraints (quantity>=0, reserved<=quantity, movement quantity>0) enforce non-negativity since Prisma cannot express them; every balance change writes a stock_movements row in the same transaction so a retry cannot inflate stock."}, {"id": "backend_architecture_side_effects_after_commit", "label": "Side Effects Happen After Commit", "file_type": "rationale", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BullMQ jobs are not rolled back with the database transaction, so enqueuing notifications/audit inside a transaction that later fails would announce an event that never happened; writing after commit means the worst case is a missing notification, not a false one. The stock-blocked notice is queued from the catch block after rollback."}, {"id": "backend_architecture_scope_guard", "label": "ScopeGuard / assertFactoryScope Dual Implementation", "file_type": "rationale", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ScopeGuard covers routes that name their factory in the request; services use assertFactoryScope() because most routes identify the factory only after loading the entity. Both refuse with 403; no service re-derives the check."}, {"id": "backend_architecture_response_envelope", "label": "Response Envelope Interceptor Ordering", "file_type": "rationale", "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AuditLogInterceptor is registered after ResponseFormatInterceptor precisely so audit snapshots the plain DTO and the formatter wraps afterwards; Nest unwinds interceptors in reverse registration order, so swapping them would have audit recording envelopes."}], "edges": [{"source": "backend_architecture_doc", "target": "backend_readme_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_doc", "target": "backend_claude_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_doc", "target": "context_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_doc", "target": "scratch_exchange_final_review_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_doc", "target": "docs_19_backend_folder_structure_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_exchange_state_machine", "target": "backend_claude_module_exchange", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_exchange_state_machine", "target": "context_exchange_state", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_stock_ledger_invariants", "target": "context_stock_movement", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "backend_architecture_stock_ledger_invariants", "target": "docs_11_database_erd_physical_schema_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Backend/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "