{"nodes": [{"id": "backend_claude_doc", "label": "Backend CLAUDE.md", "file_type": "document", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_20_setup_prompting_guide_doc", "label": "Setup Prompting Guide", "file_type": "document", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_adr_001_modular_monolith", "label": "ADR-001 Modular Monolith", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One REST service, one database, modules separated logically by folder (package-by-feature); modules ship together, never their own service/deployment. Chosen because inventory consistency is easier inside a single transaction; module boundaries drawn so a module could be extracted later if scale demands it."}, {"id": "backend_claude_adr_002_postgresql", "label": "ADR-002 PostgreSQL", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL chosen as the DBMS for ACID guarantees, relational inventory model, constraints, reporting fit, and mature ecosystem."}, {"id": "backend_claude_adr_003_trolley_location", "label": "ADR-003 Trolley Is an Inventory Location", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every trolley is a stock location in its own right, not merely a device; supports 3 trolleys per factory, configurable trolley counts, transfer, per-trolley monitoring, and reconciliation. A trolley owns a TROLLEY-typed location rather than holding stock directly."}, {"id": "backend_claude_adr_004_backend_stock_authority", "label": "ADR-004 Backend Is the Stock Authority", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server validates and executes every business rule and stock mutation; data from mobile/web is a claim to re-validate, never truth. Access tokens carry only sub/username/type; roles, permissions and scopes are reloaded per request so a deactivated user or revoked grant takes effect immediately."}, {"id": "backend_claude_adr_005_offline_first_android", "label": "ADR-005 Offline-First Android", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands arrive out of order and repeat because production-floor network availability cannot be assumed; every critical command is idempotent (Idempotency-Key / client_transaction_id)."}, {"id": "backend_claude_adr_006_whatsapp_notification_only", "label": "ADR-006 WhatsApp Is the Only Notification Channel", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outbound only; it notifies but never triggers a mutation, which is why WhatsAppPort has no receive method. Approval must occur through an authenticated secure system page, preventing transaction mutation via messaging channel."}, {"id": "backend_claude_idempotency_mechanism", "label": "Idempotency-Key / client_transaction_id Mechanism", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical commands (create exchange, issue, complete, approval, receiving, transfer, return, adjustment, sync) accept Idempotency-Key/client_transaction_id and return the same result on retry, single implementation in IdempotencyKeyMiddleware. Reusing a key with a different body returns 422; a concurrent retry returns 409."}, {"id": "backend_claude_rbac_five_dimensions", "label": "Five-Dimension Authorization Model", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User, Role+Permission, Factory scope, Location scope, Action. Permission codes match as exact strings and imply nothing else."}, {"id": "backend_claude_audit_mechanism", "label": "Audit Logging Mechanism", "file_type": "rationale", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AuditLogInterceptor writes an audit_logs row for LOGIN, CREATE_EXCHANGE, APPROVE_CONFIRMATION, REJECT_CONFIRMATION, ISSUE_NEEDLE, TRANSFER_STOCK, ADJUST_STOCK, CHANGE_MASTER, CHANGE_CONFIGURATION, DEVICE_BIND, DEVICE_REVOKE. Only successful actions are recorded; row written before response release but as a separate write from the handler transaction."}, {"id": "backend_claude_module_identity", "label": "identity module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_device", "label": "device module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_employee", "label": "employee module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_master_data", "label": "master-data module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_exchange", "label": "exchange module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_approval", "label": "approval module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_inventory", "label": "inventory module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_notification", "label": "notification module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_audit", "label": "audit module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_reporting", "label": "reporting module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_synchronization", "label": "synchronization module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_claude_module_rfid", "label": "rfid module", "file_type": "concept", "source_file": "Backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor