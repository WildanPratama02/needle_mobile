# ---------------------------------------------------------------------------
# Needle Mobile System — backend environment
# Copy to `.env` and adjust. Every variable here is validated at boot by
# src/config/validation.schema.ts — the app refuses to start if one is missing.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=docs

# Browser origins allowed to call the API, comma separated. Only the WebApp
# needs this — the Android client is not subject to the same-origin policy.
# Leave empty to disable CORS; list exact origins in production, never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# --- Database (PostgreSQL, ADR-002) ---
# Must match the postgres service credentials in docker-compose.yml.
DATABASE_URL=postgresql://needle:needle_dev_password@localhost:5432/needle_dev?schema=public

# Consumed by docker-compose.yml only. POSTGRES_PORT is the *host* port — if you
# change it because something already owns 5432, change the port in DATABASE_URL
# above to match. See README "Port conflicts".
POSTGRES_USER=needle
POSTGRES_PASSWORD=needle_dev_password
POSTGRES_DB=needle_dev
POSTGRES_PORT=5432

# --- Auth (custom JWT, access + refresh) ---
# Generate real secrets before any non-local use: `openssl rand -hex 32`
JWT_SECRET=change_me_dev_access_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (cache + BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Object storage (MinIO, evidence photos) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=needle_minio
MINIO_ROOT_PASSWORD=needle_minio_password
MINIO_BUCKET=needle-evidence

# --- WhatsApp (Meta Cloud API direct) ---
# Outbound notification only — no inbound webhook ever mutates state (ADR-006).
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Language code of the approved provider templates.
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Domain configuration ---
# TTL after which a PENDING confirmation is auto-EXPIRED by the scheduler.
CONFIRMATION_TTL_HOURS=24

# How long a stored idempotent response stays replayable. Past this a retry of
# the same command runs for real again, so keep it comfortably longer than the
# mobile client's offline retry window.
IDEMPOTENCY_RETENTION_HOURS=24
