// Needle Mobile System — Prisma schema
//
// ORM decision: Prisma (final, Backend/CLAUDE.md §6). DBMS: PostgreSQL (ADR-002).
// Table and column names follow Docs/11-Database-ERD-Physical-Schema.md §25.
//
// Models land in the ticket that owns them:
//   - identity / RBAC / RefreshToken -> issue 02
//   - master data (factory, location, trolley, needle, exchange type) -> issue 03
//   - exchange, evidence, confirmation, AuditLog -> issue 04
//
// Migrations live in `prisma/migrations/` (Prisma's own convention), not in
// `src/database/migrations/` as sketched in Docs/19 — see README §Deviations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access (Docs/11 §25)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(64)
  name         String     @db.VarChar(255)
  email        String?    @unique @db.VarChar(255)
  /// E.164 WhatsApp destination. Not in Docs/11 §25, authored for issue 08:
  /// Docs/14 requires notifying a supervisor by WhatsApp and §12 speaks of
  /// protecting personal phone numbers, but no column existed to hold one.
  phoneNumber  String?    @map("phone_number") @db.VarChar(32)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles          UserRole[]
  factoryScopes  UserFactoryScope[]
  locationScopes UserLocationScope[]
  refreshTokens  RefreshToken[]

  picExchanges          Exchange[]             @relation("ExchangePic")
  uploadedEvidence      ExchangeEvidence[]     @relation("EvidenceUploader")
  assignedConfirmations Confirmation[]         @relation("ConfirmationApprover")
  confirmationDecisions ConfirmationDecision[] @relation("ConfirmationDecider")
  stockMovements        StockMovement[]        @relation("MovementCreator")
  auditLogs             AuditLog[]             @relation("AuditActor")
  notifications         Notification[]         @relation("NotificationRecipient")

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(64)
  name        String     @db.VarChar(255)
  description String?    @db.VarChar(500)
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserFactoryScope {
  userId    String   @map("user_id") @db.Uuid
  factoryId String   @map("factory_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@id([userId, factoryId])
  @@index([factoryId])
  @@map("user_factory_scopes")
}

model UserLocationScope {
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_location_scopes")
}

// Not in Docs/10 — authored for the custom-JWT decision (Backend/CLAUDE.md §6).
// Only the hash is stored: a database leak must not yield usable refresh tokens.
// Rotation sets `revokedAt` on the old row and inserts a new one.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  deviceId  String?   @map("device_id") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Master data (Docs/11 §6-14, §20)
//
// Schema and seed only. The `device`, `employee` and `master-data` modules —
// controllers, services, CRUD endpoints — are future work; these models exist
// now because `exchanges` (issue 04) needs somewhere to point its foreign keys,
// and issue 05 needs a stock balance to read.
// ---------------------------------------------------------------------------

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum LocationType {
  WAREHOUSE
  TROLLEY
  USED_NEEDLE_STORAGE
}

model Factory {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(50)
  name        String       @db.VarChar(150)
  description String?
  timezone    String       @db.VarChar(100)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  locations         Location[]
  trolleys          Trolley[]
  devices           Device[]
  employees         Employee[]
  inventoryBalances InventoryBalance[]
  userFactoryScopes UserFactoryScope[]
  exchanges         Exchange[]
  stockMovements    StockMovement[]

  @@map("factories")
}

/// Stock lives at a Location, never at a Trolley directly — a trolley *is* an
/// inventory location (ADR-003). `parentLocationId` is the self-reference that
/// lets a trolley or storage bay sit under its warehouse.
model Location {
  id               String       @id @default(uuid()) @db.Uuid
  factoryId        String       @map("factory_id") @db.Uuid
  parentLocationId String?      @map("parent_location_id") @db.Uuid
  code             String       @db.VarChar(50)
  name             String       @db.VarChar(150)
  locationType     LocationType @map("location_type")
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory  Factory    @relation(fields: [factoryId], references: [id])
  parent   Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  children Location[] @relation("LocationHierarchy")

  trolley            Trolley?
  storageMappings    StorageMapping[]
  inventoryBalances  InventoryBalance[]
  userLocationScopes UserLocationScope[]
  outboundMovements  StockMovement[]     @relation("MovementSource")
  inboundMovements   StockMovement[]     @relation("MovementDestination")

  @@unique([factoryId, code])
  @@index([factoryId])
  @@index([locationType])
  @@map("locations")
}

/// `locationId` is unique: one trolley owns exactly one location, and that
/// location must have `locationType = TROLLEY`. Docs/11 §8 leaves that
/// cross-row rule to the backend — see the ticket note on triggers.
model Trolley {
  id         String       @id @default(uuid()) @db.Uuid
  factoryId  String       @map("factory_id") @db.Uuid
  locationId String       @unique @map("location_id") @db.Uuid
  code       String       @unique @db.VarChar(50)
  name       String       @db.VarChar(150)
  status     EntityStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory  Factory  @relation(fields: [factoryId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  devices         Device[]
  storageMappings StorageMapping[]
  exchanges       Exchange[]

  @@index([factoryId])
  @@map("trolleys")
}

model Device {
  id           String       @id @default(uuid()) @db.Uuid
  deviceCode   String       @unique @map("device_code") @db.VarChar(100)
  deviceName   String       @map("device_name") @db.VarChar(150)
  serialNumber String       @unique @map("serial_number") @db.VarChar(150)
  factoryId    String       @map("factory_id") @db.Uuid
  trolleyId    String       @map("trolley_id") @db.Uuid
  status       DeviceStatus @default(ACTIVE)
  appVersion   String?      @map("app_version") @db.VarChar(50)
  lastSeenAt   DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory Factory @relation(fields: [factoryId], references: [id])
  trolley Trolley @relation(fields: [trolleyId], references: [id])

  exchanges Exchange[]

  @@index([factoryId])
  @@index([trolleyId])
  @@map("devices")
}

/// The factory-floor worker who brings a needle to exchange. Never logs in —
/// identified by RFID tap only (CONTEXT.md), so there is no password here and
/// no relation to `users`.
model Employee {
  id             String       @id @default(uuid()) @db.Uuid
  employeeNumber String       @unique @map("employee_number") @db.VarChar(50)
  name           String       @db.VarChar(150)
  department     String?      @db.VarChar(100)
  factoryId      String       @map("factory_id") @db.Uuid
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory   Factory    @relation(fields: [factoryId], references: [id])
  rfidCards RfidCard[]
  exchanges Exchange[]

  @@index([factoryId])
  @@map("employees")
}

model RfidCard {
  id         String       @id @default(uuid()) @db.Uuid
  rfidUid    String       @unique @map("rfid_uid") @db.VarChar(150)
  employeeId String       @map("employee_id") @db.Uuid
  status     EntityStatus @default(ACTIVE)
  issuedAt   DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("rfid_cards")
}

model NeedleType {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(50)
  name         String       @db.VarChar(150)
  category     String?      @db.VarChar(100)
  unit         String       @db.VarChar(20)
  minimumStock Decimal      @default(0) @map("minimum_stock") @db.Decimal(18, 3)
  description  String?
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryBalances InventoryBalance[]
  oldNeedleUses     Exchange[]         @relation("ExchangeOldNeedle")
  newNeedleUses     Exchange[]         @relation("ExchangeNewNeedle")
  stockMovements    StockMovement[]

  @@map("needle_types")
}

/// Rows are `BROKEN` / `BENT` / `CHANGEOVER` (CONTEXT.md). Kept as a table
/// rather than an enum because `requiresFragmentValidation` is data an admin
/// maintains, and `storage_mappings` needs something to point a FK at.
model ExchangeType {
  id                         String       @id @default(uuid()) @db.Uuid
  code                       String       @unique @db.VarChar(30)
  name                       String       @db.VarChar(100)
  description                String?
  requiresFragmentValidation Boolean      @default(false) @map("requires_fragment_validation")
  status                     EntityStatus @default(ACTIVE)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  storageMappings StorageMapping[]
  exchanges       Exchange[]

  @@map("exchange_types")
}

/// Where a used needle goes once an exchange of a given type completes: one
/// storage location per (trolley, exchange type). The target location must be
/// `USED_NEEDLE_STORAGE` (Docs/11 §14).
model StorageMapping {
  id                String       @id @default(uuid()) @db.Uuid
  trolleyId         String       @map("trolley_id") @db.Uuid
  exchangeTypeId    String       @map("exchange_type_id") @db.Uuid
  storageLocationId String       @map("storage_location_id") @db.Uuid
  status            EntityStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  trolley         Trolley      @relation(fields: [trolleyId], references: [id])
  exchangeType    ExchangeType @relation(fields: [exchangeTypeId], references: [id])
  storageLocation Location     @relation(fields: [storageLocationId], references: [id])

  @@unique([trolleyId, exchangeTypeId])
  @@index([storageLocationId])
  @@map("storage_mappings")
}

/// Current balance snapshot per (location, needle type).
///
/// This is a snapshot, never the source of truth: every mutation must also
/// write a `stock_movements` ledger entry (Backend/CLAUDE.md §5). That table
/// and the `inventory` module belong to a later ticket — this model exists so
/// issue 05's stock check at the `NEEDLE_ISSUED` transition has something to
/// read.
model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  factoryId        String   @map("factory_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  needleTypeId     String   @map("needle_type_id") @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory    Factory    @relation(fields: [factoryId], references: [id])
  location   Location   @relation(fields: [locationId], references: [id])
  needleType NeedleType @relation(fields: [needleTypeId], references: [id])

  @@unique([locationId, needleTypeId])
  @@index([factoryId])
  @@index([needleTypeId])
  @@map("inventory_balances")
}

// ---------------------------------------------------------------------------
// Exchange (Docs/11 §15-19, CONTEXT.md, .scratch/exchange/spec.md)
// ---------------------------------------------------------------------------

/// The canonical state machine (Docs/10 §8.2, marked authoritative).
///
/// `FRAGMENT_CHECK` and `CONFIRMATION_PENDING` apply only to `BROKEN`
/// exchanges, and `CONFIRMATION_PENDING` only when Fragment Status is
/// `NOT_FOUND`. "Blocked" is deliberately absent: a rejected confirmation or
/// insufficient trolley stock leaves the exchange sitting at its current state
/// until someone cancels it (CONTEXT.md).
enum ExchangeState {
  CREATED
  OPERATOR_IDENTIFIED
  NEEDLE_SELECTED
  EXCHANGE_TYPE_SELECTED
  FRAGMENT_CHECK
  CONFIRMATION_PENDING
  EVIDENCE_CAPTURED
  NEW_NEEDLE_SELECTED
  NEEDLE_ISSUED
  USED_NEEDLE_STORED
  COMPLETED
  CANCELLED
}

/// Only two values. Docs/11 §15 also suggests `NOT_REQUIRED` and `PENDING`,
/// but CONTEXT.md is canonical and spec round 4 Q6 removed the need for either:
/// BENT and CHANGEOVER skip FRAGMENT_CHECK entirely rather than recording a
/// placeholder. The column is null until a BROKEN exchange reaches that step.
enum FragmentStatus {
  FOUND
  NOT_FOUND
}

enum EvidenceType {
  OLD_NEEDLE
  BROKEN_FRAGMENT
  OTHER
}

/// Tracks the upload itself, not the exchange. A row is created when the client
/// announces a capture and flips to UPLOADED once the object lands in MinIO.
enum EvidenceStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// The decision act — a Confirmation can be EXPIRED without any decision, so
/// this is narrower than ConfirmationStatus (CONTEXT.md).
enum ConfirmationDecisionType {
  APPROVED
  REJECTED
}

enum MovementType {
  RECEIVING
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  ADJUSTMENT
  REVERSAL
}

/// One needle exchange, driven through `state` by the transitions in issue 05.
///
/// Docs/11 §15 also carries a `confirmation_id` column, deliberately omitted
/// here: §18 recommends UNIQUE(exchange_id) on confirmations, which already
/// makes the relationship one-to-one from the other side. Keeping both would
/// mean a circular foreign key with no way to insert either row first.
model Exchange {
  id                  String          @id @default(uuid()) @db.Uuid
  exchangeNumber      String          @unique @map("exchange_number") @db.VarChar(50)
  /// Mobile's own id for the command, deduplicated per device (ADR-005).
  clientTransactionId String          @map("client_transaction_id") @db.VarChar(100)
  factoryId           String          @map("factory_id") @db.Uuid
  trolleyId           String          @map("trolley_id") @db.Uuid
  deviceId            String          @map("device_id") @db.Uuid
  /// The Operator (RFID-identified employee), never a system user.
  /// Null until `POST /exchanges/{id}/operator`.
  operatorId          String?         @map("operator_id") @db.Uuid
  /// The PIC running the flow — known at creation, so never null.
  picUserId           String          @map("pic_user_id") @db.Uuid
  /// Both null until `POST /exchanges/{id}/type`.
  ///
  /// Docs/11 §15 marks these NOT NULL, but it describes a finished exchange:
  /// `POST /exchanges` opens the row at `CREATED` knowing only factory,
  /// trolley and device, so the columns cannot be populated yet. Presence is
  /// enforced per state by the state machine instead of by the column.
  oldNeedleTypeId     String?         @map("old_needle_type_id") @db.Uuid
  exchangeTypeId      String?         @map("exchange_type_id") @db.Uuid
  newNeedleTypeId     String?         @map("new_needle_type_id") @db.Uuid
  fragmentStatus      FragmentStatus? @map("fragment_status")
  /// Column is `status` to match Docs/11; the field is `state` because
  /// CONTEXT.md's term is Exchange State, and `status` is already overloaded
  /// across this schema.
  state               ExchangeState   @default(CREATED) @map("status")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(6)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  /// Not in Docs/11 §15, authored for issue 09. Docs/03 UC-MOB-014 has the PIC
  /// choose a reason when cancelling, and there was nowhere to keep it: a
  /// pre-issue cancellation writes no stock movement, so `stock_movements.reason`
  /// only covers the post-issue case.
  cancellationReason  String?         @map("cancellation_reason")

  factory       Factory       @relation(fields: [factoryId], references: [id])
  trolley       Trolley       @relation(fields: [trolleyId], references: [id])
  device        Device        @relation(fields: [deviceId], references: [id])
  operator      Employee?     @relation(fields: [operatorId], references: [id])
  picUser       User          @relation("ExchangePic", fields: [picUserId], references: [id])
  oldNeedleType NeedleType?   @relation("ExchangeOldNeedle", fields: [oldNeedleTypeId], references: [id])
  newNeedleType NeedleType?   @relation("ExchangeNewNeedle", fields: [newNeedleTypeId], references: [id])
  exchangeType  ExchangeType? @relation(fields: [exchangeTypeId], references: [id])

  evidence      ExchangeEvidence[]
  confirmation  Confirmation?
  notifications Notification[]

  // Docs/11 §16: the same mobile command retried must yield one transaction.
  @@unique([deviceId, clientTransactionId])
  @@index([clientTransactionId])
  @@index([factoryId, createdAt])
  @@index([trolleyId, createdAt])
  @@index([operatorId, createdAt])
  @@index([state])
  @@map("exchanges")
}

/// A captured photo. The binary lives in MinIO; `storageKey` is the pointer
/// (Docs/11 §17 — evidence binary stays out of the relational database).
model ExchangeEvidence {
  id           String         @id @default(uuid()) @db.Uuid
  exchangeId   String         @map("exchange_id") @db.Uuid
  evidenceType EvidenceType   @map("evidence_type")
  storageKey   String         @map("storage_key") @db.VarChar(500)
  fileName     String?        @map("file_name") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  fileSize     BigInt?        @map("file_size")
  checksum     String?        @db.VarChar(128)
  capturedAt   DateTime       @map("captured_at") @db.Timestamptz(6)
  uploadedAt   DateTime?      @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy   String         @map("uploaded_by") @db.Uuid
  status       EvidenceStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  uploader User     @relation("EvidenceUploader", fields: [uploadedBy], references: [id])

  @@index([exchangeId])
  @@map("exchange_evidence")
}

/// Raised when a BROKEN exchange reports Fragment Status NOT_FOUND.
///
/// `dueAt` carries the TTL from CONFIRMATION_TTL_HOURS; a scheduled job flips
/// still-PENDING rows to EXPIRED past that point (spec decision 1).
model Confirmation {
  id                 String             @id @default(uuid()) @db.Uuid
  confirmationNumber String             @unique @map("confirmation_number") @db.VarChar(50)
  exchangeId         String             @unique @map("exchange_id") @db.Uuid
  requestedToUserId  String             @map("requested_to_user_id") @db.Uuid
  status             ConfirmationStatus @default(PENDING)
  requestedAt        DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(6)
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  exchange        Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  requestedToUser User     @relation("ConfirmationApprover", fields: [requestedToUserId], references: [id])

  decisions     ConfirmationDecision[]
  notifications Notification[]

  @@index([status])
  @@index([requestedToUserId])
  @@index([dueAt])
  @@map("confirmations")
}

/// The Approval act. `reason` is mandatory on rejection — enforced by a CHECK
/// constraint in the migration, not left to the service alone (Docs/11 §19).
model ConfirmationDecision {
  id             String                   @id @default(uuid()) @db.Uuid
  confirmationId String                   @map("confirmation_id") @db.Uuid
  decision       ConfirmationDecisionType
  decidedBy      String                   @map("decided_by") @db.Uuid
  reason         String?
  decidedAt      DateTime                 @default(now()) @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  confirmation Confirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  decider      User         @relation("ConfirmationDecider", fields: [decidedBy], references: [id])

  @@index([confirmationId])
  @@map("confirmation_decisions")
}

// ---------------------------------------------------------------------------
// Inventory ledger, audit and idempotency
// ---------------------------------------------------------------------------

/// Append-only stock ledger. Every balance mutation must land here too — a
/// balance update without a movement row is a bug (Backend/CLAUDE.md §5).
///
/// `quantity` is always a positive magnitude; direction comes from
/// `movementType` plus the source / destination pair (Docs/11 §21).
/// `referenceType` + `referenceId` point back at whatever caused it, e.g.
/// `EXCHANGE` + `exchanges.id` (Docs/11 §22) — a loose reference by design,
/// since the causes live in several tables.
model StockMovement {
  id                    String       @id @default(uuid()) @db.Uuid
  movementNumber        String       @unique @map("movement_number") @db.VarChar(50)
  movementType          MovementType @map("movement_type")
  factoryId             String       @map("factory_id") @db.Uuid
  sourceLocationId      String?      @map("source_location_id") @db.Uuid
  destinationLocationId String?      @map("destination_location_id") @db.Uuid
  needleTypeId          String       @map("needle_type_id") @db.Uuid
  quantity              Decimal      @db.Decimal(18, 3)
  referenceType         String       @map("reference_type") @db.VarChar(40)
  referenceId           String       @map("reference_id") @db.Uuid
  reason                String?
  createdBy             String       @map("created_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  factory             Factory    @relation(fields: [factoryId], references: [id])
  sourceLocation      Location?  @relation("MovementSource", fields: [sourceLocationId], references: [id])
  destinationLocation Location?  @relation("MovementDestination", fields: [destinationLocationId], references: [id])
  needleType          NeedleType @relation(fields: [needleTypeId], references: [id])
  creator             User       @relation("MovementCreator", fields: [createdBy], references: [id])

  @@index([factoryId, createdAt])
  @@index([needleTypeId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

/// Written by AuditLogInterceptor, never by hand in a service
/// (Backend/CLAUDE.md §5).
///
/// `actorUserId` is nullable because not every audited action has a human
/// behind it — the confirmation-expiry job (spec decision 1) acts on its own.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  timestamp     DateTime @default(now()) @db.Timestamptz(6)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorDeviceId String?  @map("actor_device_id") @db.Uuid
  action        String   @db.VarChar(64)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.Uuid
  factoryId     String?  @map("factory_id") @db.Uuid
  requestId     String?  @map("request_id") @db.VarChar(100)
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  metadata      Json?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, timestamp])
  @@index([entityType, entityId])
  @@index([factoryId, timestamp])
  @@map("audit_logs")
}

/// Backs IdempotencyKeyMiddleware: the first response for a key is stored and
/// replayed on retry, so a command never runs twice.
///
/// Scoped by (key, endpoint) rather than the key alone — spec round 4 Q7 —
/// because mobile issues one key per state transition, not per exchange
/// lifetime, and the same key reaching a different endpoint is a distinct call.
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(255)
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  deviceId       String?   @map("device_id") @db.VarChar(128)
  endpoint       String    @db.VarChar(255)
  /// Hash of the request body: the same key with different content is a
  /// client bug and must not silently replay the first response.
  requestHash    String    @map("request_hash") @db.VarChar(128)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)

  @@unique([idempotencyKey, endpoint])
  @@index([idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Notification (Docs/11 §26, Docs/14)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  WHATSAPP
}

/// Docs/14 §9. Docs/11 §26 suggests a shorter `NOT_SENT / SENT / DELIVERED /
/// FAILED`; Docs/14 is the integration spec this ticket and Docs/19 both cite,
/// so its five-value set wins. `QUEUED` replaces `NOT_SENT`.
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  /// A BROKEN exchange lost its fragment — sent to the Authorized Approver.
  CONFIRMATION_REQUESTED
  /// The approver approved or rejected — sent to the PIC.
  CONFIRMATION_DECIDED
  /// The exchange stopped advancing — sent to the PIC.
  EXCHANGE_STUCK
}

/// Outbound notifications only. ADR-006: WhatsApp never triggers a mutation,
/// and per round 4 Q12 there is no inbound webhook at all — Docs/14 §7-8 is
/// superseded. Approve and reject happen solely through the authenticated
/// confirmation endpoints.
model Notification {
  id                 String              @id @default(uuid()) @db.Uuid
  notificationType   NotificationType    @map("notification_type")
  channel            NotificationChannel @default(WHATSAPP)
  recipientUserId    String?             @map("recipient_user_id") @db.Uuid
  /// The address actually dialled — resolved at dispatch, kept for audit even
  /// if the user's number later changes (Docs/14 §13).
  recipientReference String?             @map("recipient_reference") @db.VarChar(64)
  exchangeId         String?             @map("exchange_id") @db.Uuid
  confirmationId     String?             @map("confirmation_id") @db.Uuid
  templateCode       String              @map("template_code") @db.VarChar(64)
  /// Rendered variables, kept so a retry sends exactly what was first composed.
  payload            Json?
  status             NotificationStatus  @default(QUEUED)
  providerMessageId  String?             @map("provider_message_id") @db.VarChar(128)
  failureReason      String?             @map("failure_reason")
  /// Docs/14 §11: (confirmation + template + recipient) must yield one logical
  /// notification. Generalised to cover exchange-scoped notices, which have no
  /// confirmation. A unique index makes the rule the database's job, not a
  /// racy read-then-write.
  dedupeKey          String              @unique @map("dedupe_key") @db.VarChar(255)
  sentAt             DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt        DateTime?           @map("delivered_at") @db.Timestamptz(6)
  readAt             DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient    User?         @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  exchange     Exchange?     @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  confirmation Confirmation? @relation(fields: [confirmationId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
  @@index([confirmationId])
  @@index([status])
  @@map("notifications")
}

/// Per-day counters behind `exchange_number` and `confirmation_number`
/// (spec round 4 Q13). One row per (scope, date); the service increments
/// `lastValue` atomically and formats e.g. `EXC-20260810-000001`.
///
/// Application-level rather than a Postgres sequence because the number has to
/// reset daily and carry a scope prefix, which a sequence cannot express.
model NumberSequence {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String   @db.VarChar(50)
  date      DateTime @db.Date
  lastValue Int      @default(0) @map("last_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, date])
  @@map("number_sequences")
}
